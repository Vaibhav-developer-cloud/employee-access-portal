# Root .gitignore for Employee Access Management System

# OS files
.DS_Store
Thumbs.db

# Python / backend
backend/venv/
backend/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd
backend/*.pyc
backend/.Python
backend/env/
backend/.env
backend/*.sqlite3

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/*.local
frontend/.env

# IDE files
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Misc
*.swp
*~
